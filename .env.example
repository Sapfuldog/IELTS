# Copy to .env and fill in.

# Required: get a token from @BotFather in Telegram.
BOT_TOKEN=123456:ABC-DEF_your_token_here

# Optional: enables AI-based feedback for Writing & Speaking.
# Without it the bot falls back to a built-in rule-based evaluator.
ANTHROPIC_API_KEY=

# Optional: model used for AI feedback.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional: path to the SQLite database file.
DB_PATH=data/ielts.db

# Optional: proxy for reaching api.telegram.org, if it is blocked on your
# network. Requires:  pip install aiohttp-socks
# Examples:  http://user:pass@host:port   or   socks5://host:1080
TELEGRAM_PROXY=
